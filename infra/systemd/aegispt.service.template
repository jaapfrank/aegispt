[Unit]
Description=AegisPT Operator Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__OWNER_USER__
Group=__OWNER_USER__
WorkingDirectory=__REPO_ROOT__
EnvironmentFile=__ENV_PATH__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash __RUN_SCRIPT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
