APP_ENV=development
APP_NAME=AegisPT
API_PORT=8000
TASK_DISPATCH_MODE=dramatiq
POSTGRES_DATA_DIR=/srv/aegispt/postgres
MINIO_DATA_DIR=/srv/aegispt/minio
POSTGRES_DB=aegispt
POSTGRES_USER=aegispt
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://aegispt:change-me@postgres:5432/aegispt
AEGISPT_DB_KEY=
REDIS_URL=redis://redis:6379/0
ARTIFACTS_STORAGE_MODE=s3
ARTIFACTS_S3_ENDPOINT=http://minio:9000
ARTIFACTS_S3_BUCKET=aegispt-artifacts
ARTIFACTS_S3_ACCESS_KEY=minioadmin
ARTIFACTS_S3_SECRET_KEY=change-me
ARTIFACTS_S3_ENFORCE_SSE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
ZAP_BASE_URL=http://zapd:8080
ZAP_API_KEY=change-me-zap-key
AUTO_CREATE_TABLES=true
