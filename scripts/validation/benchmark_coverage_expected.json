          },
          {
            "id": "dvwa-command-injection-family",
            "family": "command injection",
            "expected_severity": "critical",
            "title_pattern": "(?i)(command injection|os command|shell injection)",
            "safe_allowed_proof_type": "controlled_canary_evidence",
            "required_evidence": ["finding_id", "canary_evidence_ref", "approval_gate", "rationale_ledger_id"],
            "unsupported_gaps": ["destructive commands, callbacks, and persistence are prohibited"]
          },
          {
            "id": "dvwa-file-inclusion-family",
            "family": "file inclusion",
            "expected_severity": "high",
            "title_pattern": "(?i)(file inclusion|path traversal|directory traversal|\\blfi\\b)",
            "safe_allowed_proof_type": "controlled_canary_evidence",
            "required_evidence": ["finding_id", "finding_evidence_ref", "task_output_id", "report_variant:technical"],
            "unsupported_gaps": ["sensitive file content must not be stored"]
          }
        ],
        "unsupported_gaps": ["DVWA security-level setup is live-lab required and not performed in dry-run mode"]
      },
