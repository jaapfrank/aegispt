            "title_pattern": "(?i)(graphql.*injection|injection.*graphql|sql.*injection)",
            "safe_allowed_proof_type": "controlled_canary_evidence",
            "required_evidence": ["finding_id", "canary_evidence_ref", "runner_decision", "coverage_truth"],
            "unsupported_gaps": ["database extraction is not accepted as benchmark proof"]
          },
          {
            "id": "dvga-broken-access-control",
