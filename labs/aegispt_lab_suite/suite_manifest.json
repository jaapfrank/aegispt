    {
      "id": "heartbeat-length-overread",
      "family": "length-controlled over-read",
      "entrypoints": ["POST /tls/heartbeat"],
      "proof_type": "flag_capture",
      "inspired_by": ["CVE-2014-0160 Heartbleed over-read pattern"],
