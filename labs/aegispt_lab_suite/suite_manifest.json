{
  "schema_version": 1,
  "suite_id": "aegispt-lab-suite-v1",
  "name": "AegisPT Standalone Lab Suite",
  "purpose": "Local Docker target for testing AegisPT generalization outside XBOW.",
  "default_base_url": "http://127.0.0.155:8088/",
  "public_target_allowed": false,
  "flag_disclosure_policy": "Flags are never included in this manifest. Use POST /grade for byte-equal verification.",
  "challenges": [
    {
      "id": "ssrf-loopback-metadata",
      "family": "ssrf",
      "entrypoints": ["POST /tools/webhook-tester", "GET /internal/metadata"],
      "proof_type": "flag_capture",
      "notes": "Local-only metadata service is reachable through the webhook fetcher."
    },
    {
      "id": "cache-key-header-confusion",
      "family": "cache poisoning",
      "entrypoints": ["GET /edge/cache"],
      "proof_type": "flag_capture",
      "notes": "Cache behavior intentionally differs across request headers."
    },
    {
      "id": "graphql-batch-authz-confusion",
      "family": "graphql authorization",
      "entrypoints": ["POST /graphql"],
      "proof_type": "flag_capture",
      "notes": "Batched operation handling has an authorization boundary bug."
