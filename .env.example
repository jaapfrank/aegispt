# AegisPT Docker Compose environment.
# Run scripts/generate_compose_env.sh to create .env with generated local
# secrets, or copy this file manually when you need explicit values.

APP_ENV=development
APP_NAME=AegisPT
COMPOSE_PROJECT_NAME=aegispt
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
AEGISPT_PORT=8000
DEPLOYMENT_TLS_TERMINATED_BY_PROXY=false
DEPLOYMENT_SECURE_COOKIES=false
DEPLOYMENT_TRUSTED_CERTIFICATE_BUNDLE=
DEPLOYMENT_OUTBOUND_PROXY_URL=
DEPLOYMENT_NO_INTERNET_MODE=false
DEPLOYMENT_OFFLINE_UPDATE_PATH=
DEPLOYMENT_MANUAL_TOOL_UPDATE_PATH=
DEPLOYMENT_DATABASE_ENCRYPTION_CONFIRMED=false
DEPLOYMENT_ARTIFACT_STORAGE_ENCRYPTION_CONFIRMED=false

POSTGRES_USER=aegispt
POSTGRES_PASSWORD=change-me-aegispt-db
POSTGRES_DB=aegispt
DATABASE_URL=postgresql+psycopg://aegispt:change-me-aegispt-db@aegispt-db:5432/aegispt
AEGISPT_DB_KEY=
REDIS_URL=redis://aegispt-redis:6379/0
TASK_DISPATCH_MODE=dramatiq
INLINE_DISPATCH_BACKGROUND=false
AUTO_CREATE_TABLES=true

ARTIFACTS_STORAGE_MODE=inline
ARTIFACTS_S3_ENFORCE_SSE=false
EXECUTION_KILL_SWITCH=false
RUNNER_TIMEOUT_SECONDS=60.0

# Replace this with a generated Fernet key before real use.
# scripts/generate_compose_env.sh replaces it automatically.
LOCAL_SECRET_ENCRYPTION_KEY=RzggHOVPg3oAV-tqGrk5l7lLcgoT6FYoRu4LkXQAWWc=
SECRET_MATERIALIZATION_MODE=encrypted_local
REQUIRE_DEPLOYMENT_SECRET_ENCRYPTION_KEY=false
DEPLOYMENT_SECRET_ENCRYPTION_KEY=

ZAP_BASE_URL=http://aegispt-tools:8080
ZAP_API_KEY=change-me-zap-key
BURP_API_URL=
BURP_API_KEY=

METASPLOIT_RPC_URL=http://127.0.0.1:55553/api/1.0
METASPLOIT_RPC_USER=aegispt
METASPLOIT_RPC_PASSWORD=change-me-metasploit
METASPLOIT_RPC_VERIFY_SSL=false
METASPLOIT_RPC_AUTO_START=true
METASPLOIT_RPC_START_BINARY=msfrpcd

BLOODHOUND_PYTHON_BINARY=bloodhound-python
IMPACKET_GETUSERSPNS_BINARY=GetUserSPNs.py
IMPACKET_GETNPUSERS_BINARY=GetNPUsers.py
IMPACKET_SECRETSDUMP_BINARY=secretsdump.py
IMPACKET_PSEXEC_BINARY=psexec.py
IMPACKET_WMIEXEC_BINARY=wmiexec.py
NETEXEC_BINARY=nxc
RESPONDER_BINARY=responder
HASHCAT_BINARY=hashcat
HASHCAT_WORDLIST_PATH=/usr/share/wordlists/rockyou.txt
KERBRUTE_BINARY=kerbrute

# Set this explicitly before enabling EASM runs. Keep blank for local installs.
EASM_CRTSH_BASE_URL=
EASM_DNS_WORDLIST_PATH=

AI_PROVIDER=disabled
AI_FINDING_ENRICHMENT_ENABLED=false
AI_FINDING_ENRICHMENT_PROVIDER=disabled
AI_FINDING_ENRICHMENT_ENDPOINT=
AI_FINDING_ENRICHMENT_API_KEY_ENV=
AI_FINDING_ENRICHMENT_MODEL=aegispt-finding-enrichment
AI_AUTOFIX_ENABLED=false
AI_AUTOFIX_PROVIDER=disabled
AI_AUTOFIX_MODEL=aegispt-autofix
AI_REPORT_DRAFTING_ENABLED=false
AI_REPORT_DRAFTING_PROVIDER=disabled
AI_AGENT_POST_TASK_ANALYSIS_ENABLED=false
AI_AGENT_POST_TASK_ANALYSIS_PROVIDER=disabled
AI_AGENT_POST_TASK_ANALYSIS_MODEL=aegispt-post-task-analysis
AI_INTAKE_INTERPRETATION_ENABLED=false
AI_INTAKE_INTERPRETATION_PROVIDER=disabled
AI_INTAKE_INTERPRETATION_MODEL=aegispt-intake-interpretation

CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_AUTHORIZE_URL=
CHATGPT_OAUTH_TOKEN_URL=
CHATGPT_OAUTH_BACKEND_API_URL=
CHATGPT_OAUTH_BACKEND_API_PATH=/codex/responses
CHATGPT_OAUTH_LOCAL_CALLBACK_ENABLED=true
CHATGPT_OAUTH_LOCAL_CALLBACK_URL=http://localhost:1455/auth/callback
CHATGPT_OAUTH_ORIGINATOR=aegispt
CHATGPT_OAUTH_MODEL=gpt-5.4

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZE_URL=
GITHUB_OAUTH_TOKEN_URL=
GITHUB_API_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_AUTHORIZE_URL=
GITLAB_OAUTH_TOKEN_URL=
GITLAB_API_URL=

SETTINGS_DEFAULT_LAN_CIDR=10.0.0.0/8
SETTINGS_DEFAULT_DOMAIN=
SETTINGS_DEFAULT_VLAN_CIDRS=
SETTINGS_DEFAULT_EXCLUDED_RANGES=
SETTINGS_DEFAULT_SCAN_PROFILE=Standard
SETTINGS_DEFAULT_SAFETY_LEVEL=passive
SETTINGS_DEFAULT_EXECUTION_LANE=passive-network-discovery
SETTINGS_CRITICAL_ALERT_DESTINATION=none
SETTINGS_NOTIFY_ON_RUN_COMPLETION=false
SETTINGS_OPERATOR_DISPLAY_NAME=operator-ui

PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
